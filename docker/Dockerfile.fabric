# syntax=docker/dockerfile:1
#
# qfp/fabric: every Fabric binary of the study in one image, built natively on the test machine
# (x86-64) from the team's post-quantum forks (no emulation, no published image):
#
#   peer, orderer, osnadmin, configtxgen, cryptogen     qchain-fabric     (-tags pqc)
#   fabric-ca-server, fabric-ca-client                  qchain-fabric-ca  (-tags pkcs11,pqc)
#   the chaincode-as-a-service builder                  /opt/ccaas/bin    (the live peer image's path)
#
# The same image runs the peers, the orderer, the CAs and the tool containers, with ECDSA or
# ML-DSA-44 identities: only the key material and one configuration line differ.
#
# The build context is made by `scripts/qfp.py build`: `git archive` of the three clones at the
# pinned commits (src/fabric, src/fabric-ca, src/fabric-lib-go). The clones are never modified.
#
# Differences from the live x86_64 images (docs/live-differences.md): Debian 13 base with a shell
# and openssl (live: scratch plus the build host's glibc 2.43 and OpenSSL 3.5.5); liboqs built
# here with default options (live: flags unrecorded; liboqs only serves ML-KEM and is not on the
# transaction path).
ARG GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d
ARG RUNTIME_IMAGE=debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

FROM ${GO_IMAGE} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends cmake ninja-build libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

# --- liboqs 0.16.0, static, with OpenSSL (the fork's fabric-lib-go needs it through liboqs-go) ---
ARG LIBOQS_VERSION=0.16.0
ARG LIBOQS_SHA256=162d5b510518ee5f285f82fa1f16402a885176e818bf1b1a4c3c91c9a2f01eae
RUN mkdir -p /build-info /src/liboqs \
    && curl -fsSL -o /tmp/liboqs.tar.gz "https://github.com/open-quantum-safe/liboqs/archive/refs/tags/${LIBOQS_VERSION}.tar.gz" \
    && echo "${LIBOQS_SHA256}  /tmp/liboqs.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/liboqs.tar.gz -C /src/liboqs --strip-components=1 \
    && cmake -S /src/liboqs -B /src/liboqs/build -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
         -DOQS_USE_OPENSSL=ON -DOQS_BUILD_ONLY_LIB=ON -DOQS_DIST_BUILD=ON -DCMAKE_INSTALL_PREFIX=/usr/local \
         > /build-info/oqs-cmake.txt 2>&1 \
    && ninja -C /src/liboqs/build install > /build-info/oqs-ninja.txt 2>&1 \
    && rm -f /tmp/liboqs.tar.gz
# liboqs-go finds liboqs through this pkg-config file (its own .config/liboqs-go.pc, with our paths)
RUN mkdir -p /usr/local/lib/pkgconfig && printf '%s\n' \
      'Name: liboqs-go' 'Description: Go bindings for liboqs' "Version: ${LIBOQS_VERSION}" \
      'Cflags: -I/usr/local/include' 'Libs: -L/usr/local/lib -loqs -lcrypto' \
      > /usr/local/lib/pkgconfig/liboqs-go.pc
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig CGO_ENABLED=1 GOTOOLCHAIN=local

# --- sources at the pinned commits ---
# Both forks' go.mod replace fabric-lib-go with this machine-local path of their author; both also
# vendor it. The build uses the vendored copy (-mod=vendor); the path exists as well so that the
# go.mod is consistent whichever way the toolchain reads it.
COPY src/fabric-lib-go /home/mohammedobeid88/fabric-lib-go
COPY src/fabric /src/fabric
COPY src/fabric-ca /src/fabric-ca
ARG FABRIC_COMMIT
ARG FABRIC_CA_COMMIT
ARG FABRIC_LIB_COMMIT

# the vendored provider and factory must be the pinned fabric-lib-go (Go's vendoring drops tests,
# test data and mocks, so those are not compared)
RUN set -e; L=/home/mohammedobeid88/fabric-lib-go; for f in fabric fabric-ca; do for d in bccsp-pqc bccsp; do \
      diff -r -x '*_test.go' -x testdata -x mocks /src/$f/vendor/github.com/hyperledger/fabric-lib-go/$d $L/$d; done; done; \
    echo "vendored bccsp-pqc and bccsp = fabric-lib-go ${FABRIC_LIB_COMMIT} (tests, test data and mocks excluded)" > /build-info/vendor-check.txt

# --- Fabric (Makefile: go install -tags "$(GO_TAGS)" -ldflags "$(GO_LDFLAGS)" -buildvcs=false) ---
WORKDIR /src/fabric
RUN set -e; M=github.com/hyperledger/fabric/common/metadata; \
    for b in peer orderer osnadmin configtxgen cryptogen; do \
      go build -mod=vendor -tags pqc -buildvcs=false \
        -ldflags "-X $M.Version=3.1.5 -X $M.CommitSHA=${FABRIC_COMMIT} -X $M.BaseDockerLabel=org.hyperledger.fabric -X $M.DockerNamespace=hyperledger" \
        -o /out/bin/$b ./cmd/$b; \
    done
# the chaincode-as-a-service builder is its own module without a vendor folder (pure Go)
RUN cd ccaas_builder && for c in detect build release; do \
      CGO_ENABLED=0 go build -buildvcs=false -o /out/ccaas/bin/$c ./cmd/$c/ || exit 1; done

# --- Fabric CA (the live tools image: -tags pkcs11,pqc) ---
WORKDIR /src/fabric-ca
RUN set -e; for b in fabric-ca-server fabric-ca-client; do \
      go build -mod=vendor -tags pkcs11,pqc -buildvcs=false \
        -ldflags "-X github.com/hyperledger/fabric-ca/lib/metadata.Version=v1.5.22" \
        -o /out/bin/$b ./cmd/$b; \
    done

RUN { echo "fabric=${FABRIC_COMMIT}"; echo "fabric_ca=${FABRIC_CA_COMMIT}"; echo "fabric_lib_go=${FABRIC_LIB_COMMIT}"; \
      echo "liboqs=${LIBOQS_VERSION}"; go version; openssl version; uname -m; } > /build-info/versions.txt \
    && for b in /out/bin/*; do echo "== $b"; ldd "$b" 2>&1 || true; done > /build-info/ldd.txt \
    && sha256sum /out/bin/* /out/ccaas/bin/* > /build-info/binaries.sha256 \
    && dpkg-query -W > /build-info/dpkg-builder.txt

FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* && echo 'hosts: files dns' > /etc/nsswitch.conf \
    && mkdir -p /var/hyperledger/production /var/hyperledger/orderer /etc/hyperledger/fabric \
    && chown -R 1000:1000 /var/hyperledger /etc/hyperledger
COPY --from=builder /out/bin/ /usr/local/bin/
COPY --from=builder /out/ccaas/bin/ /opt/ccaas/bin/
COPY --from=builder /build-info/ /opt/qfp/build-info/
RUN dpkg-query -W > /opt/qfp/build-info/dpkg-runtime.txt \
    && peer version > /opt/qfp/build-info/peer-version.txt 2>&1 \
    && orderer version > /opt/qfp/build-info/orderer-version.txt 2>&1 \
    && fabric-ca-server version > /opt/qfp/build-info/ca-version.txt 2>&1 \
    && cryptogen version >> /opt/qfp/build-info/peer-version.txt 2>&1
ARG FABRIC_COMMIT
ARG FABRIC_CA_COMMIT
LABEL org.qchain.qfp="1" org.qchain.qfp.fabric="${FABRIC_COMMIT}" org.qchain.qfp.fabric-ca="${FABRIC_CA_COMMIT}"
# a new named volume mounted on these folders takes their owner (uid 1000, as on the live network)
ENV FABRIC_CFG_PATH=/etc/hyperledger/fabric HOME=/tmp
USER 1000:1000
WORKDIR /tmp
